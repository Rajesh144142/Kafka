# Application Server Configuration
PORT=3000

# Kafka Broker Configuration
# For local dev: localhost:9092. For production: broker1:9092,broker2:9092
KAFKA_BROKERS=localhost:9092

# Database Connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=kafka_learning
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# S3 Archival Configuration
ENABLE_S3_ARCHIVE=true
S3_BUCKET_NAME=my-kafka-archive-bucket

# AWS S3 Authentication Credentials (for production usage)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
